# Neon - connection string del endpoint POOLED (el host lleva "-pooler").
# La saca del dashboard de Neon, boton "Connect".
#
# OJO: Neon te da la URL con "&channel_binding=require" al final. Ese parametro
# hace que postgres-js mande "channel_binding" como parametro de arranque y que
# Postgres rechace la conexion entera. lib/db/index.ts lo saca solo, pero si lo
# ves en el panel de Vercel podes borrarlo a mano igual.
#
# OJO: el pooler de Neon es PgBouncer en modo TRANSACCION, que es el modo que
# en Control-Secaderos rompio con postgres-js por el pipelining de consultas.
# Aca funciona porque el cliente va con `prepare: false`; el detalle y la
# medicion estan en lib/db/index.ts y en scripts/probar-base.ts.
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Conexion DIRECTA (el mismo host sin "-pooler"). La usa drizzle-kit para las
# migraciones: un DDL no tiene por que pasar por el pooler.
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar las cookies de sesion. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# PIN inicial del usuario admin que crea el seed (usuario: admin)
ADMIN_PIN="1234"
